#!/usr/bin/env python3
# analytic_langevin_equil_gpu.py
# Variant 2: OU wall without bias + random tie-break in overlaps
from __future__ import annotations
import numpy as _np

class CFG:
    WALL_MODEL = "ou"     # Variant 2 (keeps e_n, beta_t)
    R_EPS = 1e-12         # radial epsilon for cylinders
    AXIS_TIE_TOL = 1e-7   # tie tolerance on BOX penetration

def _unit(nJ, xp):
    norm = xp.linalg.norm(nJ, axis=1, keepdims=True)
    return nJ / xp.maximum(norm, xp.asarray(CFG.R_EPS, dtype=norm.dtype))

def locate_points_in_pieces_xp(P, G, xp):
    """
    Return the piece index that contains each point.
    Unbiased random tie-break when a point belongs to multiple pieces.
    """
    m = inside_masks_xp(P, G, xp)  # (K,N) booleans
    K, N = m.shape
    out = xp.full((N,), -1, dtype=xp.int32)

    hits   = m.sum(axis=0)
    single = (hits == 1)
    multi  = (hits >= 2)

    if single.any():
        I = xp.where(single)[0]
        out[I] = xp.argmax(m[:, I], axis=0).astype(xp.int32)

    if multi.any():
        I = xp.where(multi)[0]
        rndu = xp.random.random(size=I.size)
        for k, j in enumerate(I.tolist()):
            cand = xp.where(m[:, j])[0]
            pick = int(xp.floor(rndu[k] * cand.size) % cand.size)
            out[j] = cand[pick].astype(xp.int32)

    return out

def wall_bounce_ou(vJ, nJ, en_J, bt_J, s, xp):
    """
    OU wall, FDT-consistent, without post-abs bias.
    vt' = beta_t vt + sqrt(1-beta_t^2) s xi_t (tangent, 2D)
    vn' = e_n |vn_in| + sqrt(1-e_n^2) s xi_n, with vn' > 0 ensured by rare resampling.
    Inputs:
      vJ  : (M,3) incident velocities
      nJ  : (M,3) outward normal (unit) (points inward domain after correction)
      en_J, bt_J : (M,) restitution normal / tangential damping
      s   : scalar sqrt(kT/m)
    """
    nJ = _unit(nJ, xp)

    # decompose
    vn = xp.sum(vJ * nJ, axis=1)
    vt = vJ - vn[:, None] * nJ

    # tangent noise from 3D projected into the tangent plane
    xi3  = xp.random.standard_normal(size=vJ.shape, dtype=vJ.dtype)
    xi_t = xi3 - xp.sum(xi3 * nJ, axis=1, keepdims=True) * nJ

    st = xp.sqrt(xp.maximum(0.0, 1.0 - bt_J**2)) * s
    sn = xp.sqrt(xp.maximum(0.0, 1.0 - en_J**2)) * s

    vt_p = bt_J[:, None] * vt + st[:, None] * xi_t

    # normal with rare resampling to ensure outward
    vn_in = xp.abs(vn)
    xi_n  = xp.random.standard_normal(size=vn.shape, dtype=vJ.dtype)
    vn_p  = en_J * vn_in + sn * xi_n

    for _ in range(3):  # almost never loops more than once
        bad = vn_p <= 0
        if not bool(bad.any()):
            break
        xi_n = xp.random.standard_normal(size=bad.sum(), dtype=vJ.dtype)
        vn_p = xp.where(bad, en_J[bad]*vn_in[bad] + sn[bad]*xi_n, vn_p)

    vn_p = xp.maximum(vn_p, xp.asarray(CFG.R_EPS, dtype=vJ.dtype))
    return vt_p + vn_p[:, None] * nJ

def collide_one_piece_gpu(p_old, p_new, v, idx, G, xp):
    """
    Vectorized collisions for one step. Uses unbiased OU wall.
    Assumes:
      - G['types']: (K,)  0=BOX, 1=CYLX, 2=CYLY
      - per-particle e_n, bt for piece idx: via G['e_n'][idx], G['bt'][idx]
      - G contains geometry arrays for each piece kind.
      - G['kT_over_m'] is scalar kT/m
    """
    N = p_new.shape[0]
    if N == 0:
        return p_new, v, xp.zeros((0,), dtype=xp.bool_)

    p_corr = p_new.copy()
    v_corr = v.copy()
    hit = xp.zeros((N,), dtype=xp.bool_)

    t  = G['types'][idx]
    e  = G['e_n'][idx]
    bt = G['bt'][idx]

    def _apply_ou(J, n):
        enJ = e[J].astype(xp.float32)
        btJ = bt[J].astype(xp.float32)
        s   = xp.sqrt(xp.asarray(G['kT_over_m'], dtype=xp.float32))
        v_corr[J] = wall_bounce_ou(v[J].astype(xp.float32),
                                   n.astype(xp.float32), enJ, btJ, s, xp)
        hit[J] = True

    # ----------------- BOX -----------------
    mb = (t == 0)
    if mb.any():
        I = xp.where(mb)[0]
        C = G['box_c'][idx[I]]
        S = G['box_s'][idx[I]]
        X = p_new[I]
        d = X - C
        px = xp.abs(d[:, 0]) - S[:, 0] * 0.5
        py = xp.abs(d[:, 1]) - S[:, 1] * 0.5
        pz = xp.abs(d[:, 2]) - S[:, 2] * 0.5
        pen = xp.stack([xp.maximum(px, 0), xp.maximum(py, 0), xp.maximum(pz, 0)], axis=1)
        hitI = (pen.max(axis=1) > 0)
        if hitI.any():
            J = I[hitI]
            dJ = p_new[J] - G['box_c'][idx[J]]
            SJ = G['box_s'][idx[J]]
            pxJ = xp.abs(dJ[:, 0]) - SJ[:, 0] * 0.5
            pyJ = xp.abs(dJ[:, 1]) - SJ[:, 1] * 0.5
            pzJ = xp.abs(dJ[:, 2]) - SJ[:, 2] * 0.5
            penJ = xp.stack([xp.maximum(pxJ, 0), xp.maximum(pyJ, 0), xp.maximum(pzJ, 0)], axis=1)

            # unbiased tie-break among almost-equal faces
            pmax = penJ.max(axis=1, keepdims=True)
            ties = xp.abs(penJ - pmax) < CFG.AXIS_TIE_TOL
            ax   = penJ.argmax(axis=1)
            multi = ties.sum(axis=1) > 1
            if multi.any():
                I_multi = xp.where(multi)[0]
                rnd = xp.random.randint(0, 3, size=I_multi.size)
                ax2 = ax.copy()
                for k, ii in enumerate(I_multi.tolist()):
                    cand = xp.where(ties[ii])[0]
                    ax2[ii] = cand[rnd[k] % cand.size]
                ax = ax2

            n = xp.zeros((J.size, 3), dtype=xp.float32)
            XJ = p_corr[J]

            jx = xp.where(ax == 0)[0]
            if jx.size > 0:
                jj = J[jx]
                sign = xp.sign(dJ[jx, 0])
                sign = xp.where(sign == 0, xp.ones_like(sign), sign)
                XJ[jx, 0] = G['box_c'][idx[jj], 0] + sign * SJ[jx, 0] * 0.5
                n[jx, 0] = sign

            jy = xp.where(ax == 1)[0]
            if jy.size > 0:
                jj = J[jy]
                sign = xp.sign(dJ[jy, 1])
                sign = xp.where(sign == 0, xp.ones_like(sign), sign)
                XJ[jy, 1] = G['box_c'][idx[jy], 1] + sign * SJ[jy, 1] * 0.5
                n[jy, 1] = sign

            jz = xp.where(ax == 2)[0]
            if jz.size > 0:
                jj = J[jz]
                sign = xp.sign(dJ[jz, 2])
                sign = xp.where(sign == 0, xp.ones_like(sign), sign)
                XJ[jz, 2] = G['box_c'][idx[jj], 2] + sign * SJ[jz, 2] * 0.5
                n[jz, 2] = sign

            p_corr[J] = XJ
            n = _unit(n, xp)
            _apply_ou(J, n)

    # ----------------- CYLX (axis x) -----------------
    mx = (t == 1)
    if mx.any():
        I = xp.where(mx)[0]
        C = G['cyl_c'][idx[I]]
        R = G['cyl_R'][idx[I]]
        L = G['cyl_L'][idx[I]]
        X = p_new[I]

        # caps
        over = xp.abs(X[:, 0] - C[:, 0]) > (L * 0.5)
        if over.any():
            J = I[over]
            XJ = p_corr[J]
            d  = XJ[:, 0] - G['cyl_c'][idx[J], 0]
            sign = xp.sign(d)
            sign = xp.where(sign == 0, xp.ones_like(sign), sign)
            XJ[:, 0] = G['cyl_c'][idx[J], 0] + sign * (G['cyl_L'][idx[J]] * 0.5)
            n = xp.zeros_like(XJ); n[:, 0] = sign
            p_corr[J] = XJ
            n = _unit(n, xp)
            _apply_ou(J, n)

        # mantle
        I2 = xp.where(mx & (~over))[0]
        if I2.size > 0:
            C2 = G['cyl_c'][idx[I2]]; R2 = G['cyl_R'][idx[I2]]
            X2 = p_new[I2]
            ry = X2[:, 1] - C2[:, 1]; rz = X2[:, 2] - C2[:, 2]
            r  = xp.sqrt(ry*ry + rz*rz)
            out = r > R2
            if out.any():
                J = I2[out]
                C3 = G['cyl_c'][idx[J]]; R3 = G['cyl_R'][idx[J]]
                XJ = p_corr[J]
                ry = XJ[:, 1] - C3[:, 1]; rz = XJ[:, 2] - C3[:, 2]
                r  = xp.sqrt(ry*ry + rz*rz)
                r  = xp.maximum(r, xp.asarray(CFG.R_EPS, dtype=r.dtype))
                # snap to circle
                XJ[:, 1] = C3[:, 1] + R3 * (ry / r)
                XJ[:, 2] = C3[:, 2] + R3 * (rz / r)
                p_corr[J] = XJ

                # recompute normal after snap
                ry = XJ[:, 1] - C3[:, 1]; rz = XJ[:, 2] - C3[:, 2]
                r  = xp.sqrt(ry*ry + rz*rz); r = xp.maximum(r, xp.asarray(CFG.R_EPS, dtype=r.dtype))
                n  = xp.stack([xp.zeros(J.size, dtype=xp.float32), ry/r, rz/r], axis=1)
                n  = _unit(n, xp)
                _apply_ou(J, n)

    # ----------------- CYLY (axis y) -----------------
    my = (t == 2)
    if my.any():
        I = xp.where(my)[0]
        C = G['cyl_c'][idx[I]]
        R = G['cyl_R'][idx[I]]
        L = G['cyl_L'][idx[I]]
        X = p_new[I]

        # caps
        over = xp.abs(X[:, 1] - C[:, 1]) > (L * 0.5)
        if over.any():
            J = I[over]
            XJ = p_corr[J]
            d  = XJ[:, 1] - G['cyl_c'][idx[J], 1]
            sign = xp.sign(d)
            sign = xp.where(sign == 0, xp.ones_like(sign), sign)
            XJ[:, 1] = G['cyl_c'][idx[J], 1] + sign * (G['cyl_L'][idx[J]] * 0.5)
            n = xp.zeros_like(XJ); n[:, 1] = sign
            p_corr[J] = XJ
            n = _unit(n, xp)
            _apply_ou(J, n)

        # mantle
        I2 = xp.where(my & (~over))[0]
        if I2.size > 0:
            C2 = G['cyl_c'][idx[I2]]; R2 = G['cyl_R'][idx[I2]]
            X2 = p_new[I2]
            rx = X2[:, 0] - C2[:, 0]; rz = X2[:, 2] - C2[:, 2]
            r  = xp.sqrt(rx*rx + rz*rz)
            out = r > R2
            if out.any():
                J = I2[out]
                C3 = G['cyl_c'][idx[J]]; R3 = G['cyl_R'][idx[J]]
                XJ = p_corr[J]
                rx = XJ[:, 0] - C3[:, 0]; rz = XJ[:, 2] - C3[:, 2]
                r  = xp.sqrt(rx*rx + rz*rz)
                r  = xp.maximum(r, xp.asarray(CFG.R_EPS, dtype=r.dtype))
                # snap
                XJ[:, 0] = C3[:, 0] + R3 * (rx / r)
                XJ[:, 2] = C3[:, 2] + R3 * (rz / r)
                p_corr[J] = XJ

                # normal after snap
                rx = XJ[:, 0] - C3[:, 0]; rz = XJ[:, 2] - C3[:, 2]
                r  = xp.sqrt(rx*rx + rz*rz); r = xp.maximum(r, xp.asarray(CFG.R_EPS, dtype=r.dtype))
                n  = xp.stack([rx/r, xp.zeros(J.size, dtype=xp.float32), rz/r], axis=1)
                n  = _unit(n, xp)
                _apply_ou(J, n)

    return p_corr, v_corr, hit

def reflect_gpu(p_old, p_new, v, prev_idx, G, xp):
    """
    Uses collide_one_piece_gpu() and keeps the previous piece on hit.
    No 'fridge': velocities are not damped on fallback.
    """
    in_union = inside_masks_xp(p_new, G, xp).any(axis=0)
    new_idx  = locate_points_in_pieces_xp(p_new, G, xp)
    crossed  = (new_idx != prev_idx)

    need = (~in_union)
    if need.any():
        I = xp.where(need)[0]
        p_corr, v_corr, hit = collide_one_piece_gpu(p_old[I], p_new[I], v[I], prev_idx[I], G, xp)
        sel = I[hit]
        if sel.size > 0:
            p_new[sel]  = p_corr[hit]
            v[sel]      = v_corr[hit]
            new_idx[sel]= prev_idx[sel]
            crossed[sel]= False
        sel2 = I[~hit]
        if sel2.size > 0:
            # fallback: revert position, keep velocity (no fridge)
            p_new[sel2] = p_old[sel2]
            new_idx[sel2] = prev_idx[sel2]
            crossed[sel2] = False
    return p_new, v, new_idx, crossed

def patch_into(ns: dict):
    """
    Call: import analytic_langevin_equil_gpu as patch; patch.patch_into(globals())
    to overwrite the functions in your current module.
    """
    ns['locate_points_in_pieces_xp'] = locate_points_in_pieces_xp
    ns['collide_one_piece_gpu']      = collide_one_piece_gpu
    ns['reflect_gpu']                = reflect_gpu
    ns['wall_bounce_ou']             = wall_bounce_ou
    ns['CFG']                        = CFG
    return ns
